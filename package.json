{
  "name": "clinicaltrialsdashboard",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"npm -w client run dev\" \"npm -w server run dev\"",
    "dev:client": "npm -w client run dev",
    "dev:server": "npm -w server run dev",
    "build": "npm -w client run build && npm -w server run build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm -w server run migrate",
    "db:seed": "npm -w server run seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
