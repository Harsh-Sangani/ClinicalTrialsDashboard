generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contract {
  id            String   @id @default(uuid()) @db.Uuid
  studyNumber   String   @map("study_number")
  department    String
  contractValue Decimal  @map("contract_value") @db.Decimal(12, 2)
  balance       Decimal  @db.Decimal(12, 2)
  status        String
  startDate     DateTime @map("start_date") @db.Date
  endDate       DateTime @map("end_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("contracts")
}

model Invoice {
  id                 String    @id @default(uuid()) @db.Uuid
  department         String
  studyNumber        String    @map("study_number")
  invoiceNumber      String    @unique @map("invoice_number")
  invoiceDescription String?   @map("invoice_description")
  cost               Decimal   @db.Decimal(12, 2)
  contractNumber     String    @map("contract_number")
  paymentDate        DateTime? @map("payment_date") @db.Date
  uploadedByEmail    String    @map("uploaded_by_email")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("invoices")
}
